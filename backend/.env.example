# Supabase PostgreSQL Database URL
# Format: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Get this from: Supabase Dashboard -> Project Settings -> Database -> Connection String (Session Mode)
# Replace [PASSWORD] with your actual database password
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-password@aws-0-us-west-1.pooler.supabase.com:6543/postgres

# Optional: Direct connection (not pooled) - use port 5432
# DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-password@db.your-project-ref.supabase.co:5432/postgres

OPENAI_API_KEY=
GOOGLE_API_KEY=
ENVIRONMENT=development
